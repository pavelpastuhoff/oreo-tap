# --- Локальные директории ---

# --- Переменные окружения, токены и секреты ---
.env
.env.*
*.env
!.env.example

# --- Приватные ключи и конфиги Firebase / Google Cloud ---
*firebase*
*secret*
*token*
*firebase-adminsdk*.json
serviceAccount*.json
service-account*.json
firebase-credentials*.json
*credentials*.json
*secret*.json
*token*.json
!assets/skins/*
!assets/skins/**
.firebaserc
firebase-debug.log*
*.pem
*.key
*.p12
*.pfx
*.crt

# --- Локальные выгрузки краш-логов и баг-репортов ---
crashes_*.txt
*crash_report*.txt

# --- Системные папки Python, кэши и виртуальные окружения ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.cache
*.db
*.sqlite
*.sqlite3
venv/
.venv/
env/

# --- Инструменты разработки, Node/Netlify и ОС ---
.aider*
.gitignorepython
patch.py
node_modules/
.netlify/
.DS_Store
Thumbs.db
Desktop.ini
*.log
