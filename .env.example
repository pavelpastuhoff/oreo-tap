# Обязательный токен от @BotFather (НИКОГДА не коммитьте реальный .env!)
BOT_TOKEN=replace_with_your_botfather_token

# Обязательный криптографический секрет верификации Telegram Webhook (A-Z, a-z, 0-9, _ и -)
WEBHOOK_SECRET=replace_with_random_cryptographic_secret

# Имя бота (без @) и адрес фронтенда Mini App (GitHub Pages / статика)
BOT_USERNAME=oreo_67_bot
WEBAPP_URL=https://pavelpastuhoff.github.io/oreo-tap/
APP_VERSION=20261108

# Публичный URL вебхука (на Render подхватывается автоматически из RENDER_EXTERNAL_URL)
WEBHOOK_URL=
WEBHOOK_PATH=/webhook

# Telegram ID основателя (Админ-пульт и /broadcast) и URL базы Firebase RTDB
ADMIN_ID=594228143
ADMIN_USER_ID=594228143
FIREBASE_DB_URL=https://oreo-tap-default-rtdb.europe-west1.firebasedatabase.app
